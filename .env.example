# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
RAILWAY_PUBLIC_DOMAIN=

# Database
# Local: comment out to use SQLite (default)
# Railway: DATABASE_URL is injected automatically and may include sslmode=require
DATABASE_URL=postgresql://xiangqi_user:password@localhost:5432/xiangqi_db?sslmode=require

# CORS (if needed for frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Settings
AI_DEFAULT_DIFFICULTY=normal
AI_EASY_DEPTH=2
AI_NORMAL_DEPTH=3
AI_HARD_DEPTH=4
