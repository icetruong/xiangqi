# ── Stage 1: Build Flutter Web ──────────────────────────────────────────────
FROM ghcr.io/cirruslabs/flutter:stable AS builder

WORKDIR /app

# Copy toàn bộ project Flutter
COPY . .

# Lấy dependencies
RUN flutter pub get

# Build Flutter Web (release mode)
RUN flutter build web --release

# ── Stage 2: Serve bằng nginx ────────────────────────────────────────────────
FROM nginx:alpine

# Xoá config mặc định của nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copy nginx config dưới dạng template (chứa ${PORT})
COPY nginx.conf /etc/nginx/conf.d/nginx.conf.template

# Copy output của Flutter build
COPY --from=builder /app/build/web /usr/share/nginx/html

# Railway inject PORT động — dùng envsubst để điền PORT vào nginx config khi khởi động
# Chỉ substitute ${PORT} để không làm hỏng biến nginx khác ($uri, $host, ...)
EXPOSE 8080
CMD ["/bin/sh", "-c", "envsubst '${PORT}' < /etc/nginx/conf.d/nginx.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
